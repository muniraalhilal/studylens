# SQLite is used automatically when DATABASE_URL is omitted.
# PostgreSQL alternative (start compose database first):
# DATABASE_URL=postgresql+psycopg://studylens:studylens_local@localhost:5432/studylens
APP_ORIGIN=http://127.0.0.1:8000
# Use true behind HTTPS; keep false for local HTTP.
COOKIE_SECURE=false
# Set automatically by scripts/share_demo.py for a separate public preview.
PUBLIC_DEMO_ONLY=false
# Trust only a local cloudflared process, never arbitrary proxy headers.
TRUST_CLOUDFLARE=false
